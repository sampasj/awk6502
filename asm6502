function traceprint(mnemonic) {
    printf ( "pc=%X mnemonic=%s opcode=%X acc=%X X=%X Y=%X sp=%X p=%X\n", pc, mnemonic, code, acc, registerX, registerY, stackPointer, statusRegister)
}

function setStatusRegister (){
    statusRegister = 128 * flagN + 64 * flagV + 32 + 16 * flagB + 8 * flagD + 4 * flagI + 2 * flagZ + flagC
    if (TRACE == 1) printf ("statusRegister=%X\n", statusRegister )
}

function setEachFlag(reg) {
    # status register = NV-BDIZC
    # The `and` function is a GNU AWK extension.
    flagC = (and(reg, 1) ? 1:0 )
    flagZ = (and(reg, 2) ? 1:0 )
    flagI = (and(reg, 4) ? 1:0 )
    flagD = (and(reg, 8) ? 1:0 )
    flagB = (and(reg, 16) ? 1:0 )
    flagV = (and(reg, 64) ? 1:0 )
    flagN = (and(reg, 128) ? 1:0 )
}

function getRelativeAddr (addr){
    addr %= 256
    if (addr >= 0 && addr < 128) return addr
    if (addr >= 128 && addr < 256) return (addr - 256)
}

function setaddressingmodetbl () {
    usebyte["accumulator"] = 1
    usebyte["immediate"] = 2
    usebyte["absolute"] = 3
    usebyte["zeropage"] = 2
    usebyte["implied"] = 1
    usebyte["relative"] = 2
    usebyte["absoluteX"] = 3
    usebyte["absoluteY"] = 3
    usebyte["zeropageX"] = 2
    usebyte["zeropageY"] = 2
    usebyte["indiect"] = 3
    usebyte["indexedX"] = 2     # Indexed Indirect, X
    usebyte["indirectY"] = 2    # Indirect Indexed, Y
}

function addrmode(op, addr) {
    if (op == "NOP" || 
        op == "BRK" ||
        op == "CLC" ||
        op == "CLD" ||
        op == "CLI" ||
        op == "CLV" ||
        op == "DEX" ||
        op == "DEY" ||
        op == "INX" ||
        op == "INY" ||
        op == "PHA" ||
        op == "PHP" ||
        op == "PLA" ||
        op == "PLP" ||
        op == "SEC" ||
        op == "SED" ||
        op == "SEI" ||
        op == "TAX" ||
        op == "TAY" ||
        op == "TSX" ||
        op == "TXA" ||
        op == "TXS" ||
        op == "TYA") return "implied"
    else if (op == "BCC" ||
             op == "BCS") return "relative"
    else if (addr ~ /^#/) return "immediate"
    else if (addr ~ /^\$..$/) return "zeropage"
    else if (addr ~ /^\$..,X$/) return "zeropageX"
    else if (addr ~ /^\$....$/) return "absolute"
    else if (addr ~ /^\$....,X$/) return "absoluteX"
    else if (addr ~ /^\$....,Y$/) return "absoluteY"
    else if (addr ~ /^\(\$..,X\)$/) return "indexedX"
    else if (addr ~ /^\(\$..\),Y$/) return "indirectY"
}