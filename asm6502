function assemblerpass1() {
    # ASSEMBLER PASS 1
    FS = "[ \t]+"   # multiple spaces and/or tabs as separator
    while (getline <srcfile > 0) {
        sub(/;.*/, "")         # strip comments
        if ($2 == ".ORG") { sub(/\$/, "0x", $3); nextmem = org = strtonum($3) ; continue }
        symtab[$1] = nextmem   # remember label location
        print "pass1 nextmem 1 ", nextmem
        if ($2 != "") {        # save op, addr, bytes if present
           mode = addrmode($2, $3)
           if (mode == "absolute"){
               sub(/\$/, "0x", $3);
               $3 = strtonum($3)
           }
           else if (mode == "immediate"){
               if ($3 ~ /^#\$/){
                   sub(/#\$/, "0x", $3);
                   $3 = strtonum($3)
               }
               else {
                   sub(/#/, "", $3);
                   $3 = strtonum($3)
               }
           }
           else if (mode == "zeropage"){
                   sub(/\$/, "0x", $3);
                   $3 = strtonum($3)
           }
           else if (mode == "zeropageX"){
                   sub(/,X$/,"",$3)
                   sub(/\$/, "0x", $3);
                   $3 = strtonum($3)
           }
           else if (mode == "absoluteX"){
                   sub(/,X$/,"",$3)
                   sub(/\$/, "0x", $3);
                   $3 = strtonum($3)
           }
           else if (mode == "absoluteY"){
                   sub(/,Y$/,"",$3)
                   sub(/\$/, "0x", $3);
                   $3 = strtonum($3)
           }
           else if (mode == "indexedX"){
                   sub(/,X\)$/,"",$3)
                   sub(/\(\$/, "0x", $3);
                   $3 = strtonum($3)
           }
           else if (mode == "indirectY"){
                   sub(/\),Y$/,"",$3)
                   sub(/\(\$/, "0x", $3);
                   $3 = strtonum($3)
           }
           print $2 "\t" $3 "\t" mode >tempfile
           nextmem += usebyte[mode]
        }
    }
    close(tempfile)
}

function assemblerpass2() {
        FS = "\t"   # tab as separator
        nextmem = org
        while (getline <tempfile > 0) {
            if ($2 !~ /^[0-9]*$/)  # if symbolic addr,
               $2 = symtab[$2]     # replace by numeric value
               print "numeric value = ", $2
            mem[nextmem] = op[$1 $3]
            # print nextmem, " mem=",mem[nextmem],"  ", $1, $3,op[$1 $3]
            if ($3 == "absolute" ||
                $3 == "absoluteX" ||
                $3 == "absoluteY"){
                mem[nextmem + 1] = $2 % 256
                mem[nextmem + 2] = int ($2 / 256)
            }
            else if ($3 == "immediate"){
                mem[nextmem + 1] = $2
            }
            else if ($3 == "relative"){
                x = $2 - (nextmem + 2)
                print "pass2 x=", x,"$2=",$2,"nextmem=",nextmem
                if (x >= 0 && x < 128){
                    mem[nextmem + 1] = x
                }
                else if (x >= -128 && x < 0){
                    mem[nextmem + 1] = x + 256
                }
                else print "illegal relative jump at  ", nextmem
            }
            else if ($3 == "zeropage" ||
                     $3 == "zeropageX" ||
                     $3 == "indexedX" ||
                     $3 == "indirectY"){
                mem[nextmem + 1] = $2
            }
            nextmem += usebyte[$3]
            print "usebyte ", usebyte[$3]
        }
}

function interpreter() {
