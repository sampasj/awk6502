# asm6502 - assembler and interpreter for MOS 6502 computer
#   usage: awk -f asm6502 program-file data-file...
#
# Register variables
# acc: accumurator, A register
# registerX: index register X
# registerY: index register Y
# stackPointer: stack pointer 8 bit
# pc: program counter
# statusRegister: status register
#
# flags
# flagN: negative flag
# flagV: overflow flag
# flagB: break flag
# flagD: decimal mode flag
# flagI: interapt flag
# flagZ: zero flag
# flagC: carry flag

BEGIN {
    srcfile = ARGV[1]
    ARGV[1] = ""  # remaining files are data
    TRACE = 1     # 1:trace print registers 0:not print
    tempfile = "asm6502.temp"
    flagB = 1
    stackPointer = 255     # 0xFF
    setStatusRegister()
    setopcodetbl()
    setaddressingmodetbl()
    assemblerpass1()
    assemblerpass2()
    interpreter()
}

